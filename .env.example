# TrueFoundry OpenAI-compatible gateway credentials for the optimal-retriever PoC.
# Copy to `.env` and fill in your token, or set these in the Colab notebook.
#
# The gateway speaks the OpenAI API, so the `openai` SDK auto-reads OPENAI_API_KEY
# and OPENAI_BASE_URL — no code changes needed to point it at TrueFoundry.

# Your TrueFoundry personal access token (NOT a real OpenAI key).
OPENAI_API_KEY=

# Gateway base URL. Note the trailing /v1 (the SDK appends /chat/completions).
OPENAI_BASE_URL=https://tfy.promptlens.trilogy.com/v1

# Gateway model path used as the "optimal retriever" / golden-knowledge source.
POC_GPT_MODEL=claude-group/claude-sonnet-5
